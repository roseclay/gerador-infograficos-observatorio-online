[archive]
# Use "local" para testes em uma máquina ou "supabase" para acervo compartilhado.
provider = "supabase"

[access]
# Opcional e recomendado no modelo simples: a equipe usa esta senha no próprio app.
password = "SENHA_DA_EQUIPE"

[supabase]
# Preencha somente em st.secrets no Streamlit ou em variáveis de ambiente locais.
# Nunca commite .streamlit/secrets.toml com valores reais.
url = "https://SEU-PROJETO.supabase.co"
anon_key = "SUPABASE_ANON_KEY"
bucket = "observatorio-infograficos"

# Modelo simples: use como secret de servidor e proteja o app com [access].password.
# service_role_key = "SUPABASE_SERVICE_ROLE_KEY"
